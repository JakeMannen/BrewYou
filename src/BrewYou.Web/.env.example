# Google OAuth Client ID for Google Identity Services
PUBLIC_GOOGLE_CLIENT_ID=

# Public application base URL for mobile QR code scanning and sharing (e.g. http://192.168.1.50:3000 or https://brew.example.com)
PUBLIC_APP_URL=http://localhost:3000

# Public API base URL for external IoT sensors, webhooks, and client API communication (e.g. http://192.168.1.50:5000 or https://brew.example.com)
PUBLIC_API_URL=http://localhost:5000
